# ── Database ─────────────────────────────────────────────────────────────────
MONGODB_URI=mongodb://DB_USER:DB_PASS@cluster-shard-00-00.example.mongodb.net:27017,cluster-shard-00-01.example.mongodb.net:27017,cluster-shard-00-02.example.mongodb.net:27017/?ssl=true&replicaSet=atlas-xxxxx-shard-0&authSource=admin&appName=Cluster0

# ── Authentication ────────────────────────────────────────────────────────────
JWT_SECRET=REPLACE_WITH_MIN_64_CHAR_RANDOM_HEX                              # min 64 chars, cryptographically random
JWT_REFRESH_SECRET=REPLACE_WITH_DIFFERENT_MIN_64_CHAR_RANDOM_HEX            # min 64 chars, different from JWT_SECRET
# Routine (NON-compromise) key rotation only. Honoured ONLY while
# JWT_SECRET_PREVIOUS_EXPIRES_AT is set and <= 24h in the future. Never set an
# exposed/compromised key here. Leave both unset normally.
# JWT_SECRET_PREVIOUS=
# JWT_SECRET_PREVIOUS_EXPIRES_AT=2026-01-01T12:00:00Z
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
JWT_REFRESH_ABSOLUTE_EXPIRES_IN=90d      # absolute max regardless of activity

# ── Redis (Upstash) ───────────────────────────────────────────────────────────
UPSTASH_REDIS_REST_URL="https://YOUR_UPSTASH_ENDPOINT.upstash.io"
UPSTASH_REDIS_REST_TOKEN=REPLACE_WITH_UPSTASH_REST_TOKEN

# ── Firebase Admin SDK ────────────────────────────────────────────────────────
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY=REPLACE_WITH_FIREBASE_PRIVATE_KEY_LITERAL_N_FOR_NEWLINES   # paste full PEM key from Firebase service account JSON, replace actual newlines with \n

# ── Email (Brevo REST API) ────────────────────────────────────────────────────
BREVO_API_KEY=REPLACE_WITH_BREVO_API_KEY
BREVO_SENDER_EMAIL=your-sender@example.com
BREVO_SENDER_NAME=Genesis HR

# ── Admin Seed (Phase 2 — remove ADMIN_INITIAL_PASSWORD after seed:admin) ─────
SEED_ADMIN_EMAIL=admin@yourdomain.com
SEED_ADMIN_INITIAL_PASSWORD=                  # REMOVE FROM VERCEL ENV VARS AFTER SEEDING

# ── Cron Security ─────────────────────────────────────────────────────────────
CRON_SECRET=REPLACE_WITH_MIN_32_CHAR_RANDOM_HEX                             # Vercel sends: Authorization: Bearer <CRON_SECRET>

# ── Application ───────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Extra origins allowed to make cookie-authenticated state-changing requests
# (comma-separated). The app's own origin and NEXT_PUBLIC_APP_URL are always allowed.
# ALLOWED_ORIGINS=
# Trust X-Forwarded-For ONLY when self-hosting behind a reverse proxy that
# overwrites it. Not needed on Vercel (detected via VERCEL=1).
# TRUST_PROXY_HEADERS=false
NODE_ENV=development

# ── Auto-provided by Vercel (do NOT set manually) ────────────────────────────
# VERCEL_URL           deployment URL
# VERCEL_ENV           preview | production
